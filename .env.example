# ==============================================================================
# Agricultural Disease Observation & Expert Escalation System
# Environment Configuration Template
# Copy to .env and configure for your local or production deployment.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Connection (Default: local SQLite database; replace with PostgreSQL in production)
DATABASE_URL=sqlite:///./data/agri_disease.db
# DATABASE_URL=postgresql://agri_user:agri_password@localhost:5432/agri_disease_db

# Security & CORS
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
CORS_ORIGINS=*
# In production, restrict CORS to verified client domains:
# CORS_ORIGINS=https://agri-disease.example.org,https://expert.agri-disease.example.org

# File Upload & Safety Safeguards
MAX_CONTENT_LENGTH=10485760
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
UPLOAD_DIR=./uploads

# Machine Learning & Computer Vision
MODEL_CHECKPOINT_PATH=./ml/models/mobilenetv3_disease.pt
EVALUATION_RESULTS_PATH=./ml/models/evaluation_results.json
IMAGE_INPUT_SIZE=224

# Operational Triage Thresholds
LOW_CONFIDENCE_THRESHOLD=60.0
CRITICAL_STAGE_WEIGHT=1.5
BASELINE_T_REVIEW_HOURS=120.0
MVP_TARGET_T_REVIEW_HOURS=24.0
